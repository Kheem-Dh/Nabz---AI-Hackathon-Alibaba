# Copy to .env.production on the deployment host. Never commit that file.

# compose.prod.yaml enforces production mode and disables mock/demo/API docs.
APP_ENV=production
MOCK_MODE=false
NABZ_ENABLE_DEMO=false
NABZ_ENABLE_API_DOCS=false

# Required. Production startup fails when this is missing.
DASHSCOPE_API_KEY=replace-with-production-dashscope-key

# OpenAI is text-only fallback for Qwen quota/auth/rate/timeout/provider errors.
OPENAI_API_KEY=replace-with-production-openai-key
NABZ_OPENAI_FALLBACK_MODEL=gpt-4o
NABZ_REGISTERED_AI_BUDGET_USD=1.00
NABZ_GUEST_AI_BUDGET_USD=0.30
NABZ_AI_MAX_OUTPUT_TOKENS=4096
NABZ_OPENAI_REASONING_EFFORT=none
NABZ_QWEN_INPUT_USD_PER_M=0.40
NABZ_QWEN_CACHED_INPUT_USD_PER_M=0.08
NABZ_QWEN_OUTPUT_USD_PER_M=1.60
NABZ_OPENAI_INPUT_USD_PER_M=2.50
NABZ_OPENAI_CACHED_INPUT_USD_PER_M=1.25
NABZ_OPENAI_OUTPUT_USD_PER_M=10.00

# Explicit database configuration is required. This SQLite URL is suitable for
# one persistent VM; use a managed SQL URL before running multiple API replicas.
DATABASE_URL=sqlite:////data/nabz.db

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-production-secret

# Exact login email or phone allowed to open /admin. This is checked by every
# admin API request, not only hidden in the frontend navigation.
NABZ_ADMIN_IDENTIFIERS=owner@example.com

NABZ_TEXT_MODEL=qwen3.7-plus
NABZ_VL_MODEL=qwen3.7-plus
NABZ_VL_OCR_FALLBACK=qwen-vl-ocr
NABZ_STT_MODEL=qwen3.5-omni-plus
NABZ_TTS_ENGINE=auto
NABZ_TTS_MODEL=qwen3.5-omni-plus
NABZ_TTS_VOICE=Tina

# Same-origin Nginx proxying means CORS is not needed by the web app. Add only
# explicit HTTPS origins for any additional trusted clients.
CORS_ORIGINS=

# Keep the stage demo independent of external reverse-geocoding.
NABZ_DISABLE_NOMINATIM=1

# Production requires a private S3 or S3-compatible R2 bucket. For AWS, static
# credentials may stay empty when the container has an IAM role. R2 requires
# its endpoint and access credentials.
NABZ_STORAGE_BACKEND=s3
# Demo-only Render fallback when no S3/R2 bucket exists. Local data is lost on
# restart/deploy; keep false for durable production storage.
NABZ_ALLOW_EPHEMERAL_LOCAL_STORAGE=false
NABZ_S3_BUCKET=replace-with-private-medical-vault-bucket
NABZ_S3_REGION=ap-southeast-1
NABZ_S3_ENDPOINT_URL=
NABZ_S3_SSE=AES256
NABZ_READINESS_CHECK_S3=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Change if port 80 is already occupied on the ECS instance.
HTTP_PORT=80
