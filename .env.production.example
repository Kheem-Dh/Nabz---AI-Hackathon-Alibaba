# Copy to .env.production on the deployment host. Never commit that file.

# Start with true for a zero-credential demo; use false only with a valid key.
MOCK_MODE=true
DASHSCOPE_API_KEY=

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-production-secret

NABZ_TEXT_MODEL=qwen3.7-plus
NABZ_VL_MODEL=qwen3.7-plus
NABZ_VL_OCR_FALLBACK=qwen-vl-ocr

# Same-origin Nginx proxying means CORS is not needed by the web app. Add only
# explicit HTTPS origins for any additional trusted clients.
CORS_ORIGINS=

# Keep the stage demo independent of external reverse-geocoding.
NABZ_DISABLE_NOMINATIM=1

# Private medical-file storage. "local" uses the Docker volume below; use
# "s3" for AWS S3 or an S3-compatible private Cloudflare R2 bucket.
NABZ_STORAGE_BACKEND=local
NABZ_S3_BUCKET=
NABZ_S3_REGION=
NABZ_S3_ENDPOINT_URL=
NABZ_S3_SSE=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Change if port 80 is already occupied on the ECS instance.
HTTP_PORT=80
