# Nabz — environment variables. Copy to server/.env and edit.
#
# All values are optional. With NO key set (or MOCK_MODE=true) the whole app
# runs on realistic mock data so it can be demoed with zero credentials.

# --- Alibaba Cloud Model Studio (DashScope) ---------------------------------
DASHSCOPE_API_KEY=

# Optional text fallback. Nabz calls this only after Qwen is unavailable or
# cannot return a response that passes the existing clinical JSON validator.
OPENAI_API_KEY=
NABZ_OPENAI_FALLBACK_MODEL=gpt-4o

# Model routing (see docs/QODER_HANDOFF.md § "Model routing").
# NABZ_* is the preferred name; QWEN_* is honoured as a legacy fallback.
# Text/reasoning model for conversational triage + summary.
NABZ_TEXT_MODEL=qwen3.7-plus
QWEN_MODEL=qwen-plus

# Maximum time without a model response chunk. Final assessment synthesis can
# take longer than a follow-up question on qwen3.7-plus.
NABZ_TRIAGE_TIMEOUT_SECONDS=60

# Lifetime application allowances. The server reserves the maximum possible
# call cost before invoking a provider, then reconciles returned token usage.
NABZ_REGISTERED_AI_BUDGET_USD=1.00
NABZ_GUEST_AI_BUDGET_USD=0.30
NABZ_AI_MAX_OUTPUT_TOKENS=4096
NABZ_OPENAI_REASONING_EFFORT=none

# USD per one million tokens used by the private Admin cost ledger. Update
# these if provider list pricing or your contracted rates change.
NABZ_QWEN_INPUT_USD_PER_M=0.40
NABZ_QWEN_CACHED_INPUT_USD_PER_M=0.08
NABZ_QWEN_OUTPUT_USD_PER_M=1.60
NABZ_OPENAI_INPUT_USD_PER_M=2.50
NABZ_OPENAI_CACHED_INPUT_USD_PER_M=1.25
NABZ_OPENAI_OUTPUT_USD_PER_M=10.00

# DailyMed v2 current-label lookup. Only an allowlisted generic drug name is
# sent; no patient, transcript, diagnosis, or Vault data leaves Nabz here.
NABZ_DAILYMED_LIVE=true
NABZ_DAILYMED_TIMEOUT_SECONDS=4

# Vision/structured-extraction model for lab reports & prescriptions.
NABZ_VL_MODEL=qwen3.7-plus
QWEN_VL_MODEL=qwen-vl-plus

# Optional OCR-heavy fallback for hard handwriting.
NABZ_VL_OCR_FALLBACK=qwen-vl-ocr

# Urdu voice output. "auto" uses Qwen3.5-Omni when DASHSCOPE_API_KEY is
# configured and falls back to gTTS. "qwen" forces the live neural voice,
# "gtts" uses the lightweight fallback, and "mms" explicitly enables the
# older local MMS checkpoint.
NABZ_TTS_ENGINE=auto
NABZ_TTS_MODEL=qwen3.5-omni-plus
NABZ_TTS_VOICE=Tina

# Urdu cloud transcription. Qwen3.5-Omni supports Urdu audio; the legacy
# qwen-omni-turbo model only supports Chinese and English.
NABZ_STT_MODEL=qwen3.5-omni-plus

# --- App gates --------------------------------------------------------------
# Force mock mode even if a key is present.
MOCK_MODE=false

# JWT signing secret. Change this in any real deployment.
JWT_SECRET=change-me-nabz-dev-secret

# Owner-only analytics console. Use the exact email and/or phone on your Nabz
# account; multiple identifiers may be comma-separated. Empty disables admin.
NABZ_ADMIN_IDENTIFIERS=

# Comma-separated list of frontend origins that may call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Location / facilities --------------------------------------------------
# Set to 1 to skip OpenStreetMap reverse-geocoding and rely only on the
# offline city-center lookup (useful for stage rehearsals on flaky Wi-Fi).
NABZ_DISABLE_NOMINATIM=

# --- Phone / email verification (OTP) ---------------------------------------
# Verification is a SOFT gate: accounts work while unverified. Local fallback
# codes require the opt-in below. In production they additionally require an
# exact match in NABZ_DEMO_OTP_RECIPIENTS (comma-separated phones/emails).
NABZ_EXPOSE_DEV_OTP=false
NABZ_DEMO_OTP_RECIPIENTS=
#
# WhatsApp Cloud API (preferred phone channel). Meta's test number supports a
# limited allowlist without a payment card. Use an approved authentication
# template with one body variable and, normally, a copy-code URL button.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_COPY_CODE=true
#
# Optional SMS fallback via Twilio (all three required):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
#
# Email via SMTP (SMTP_HOST required; user/pass optional for open relays):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nabz.app
