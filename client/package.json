{
  "name": "nabz-client",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:install": "npm i -D @capacitor/cli && npm i @capacitor/core @capacitor/android @capacitor/ios",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:open:android": "cap open android",
    "cap:add:ios": "cap add ios",
    "cap:open:ios": "cap open ios",
    "mobile:build": "npm run build && cap sync",
    "mobile:android": "npm run mobile:build && cap open android",
    "mobile:ios": "npm run mobile:build && cap open ios"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
